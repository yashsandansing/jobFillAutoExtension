{
  "manifest_version": 3,
  "name": "Job Fill Auto Extension",
  "version": "1.0",
  "description": "Appends job application data to Google Sheets.",
  "permissions": [
    "activeTab",
    "identity",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "oauth2": {
    "client_id": "<YOUR_GOOGLE_OAUTH_CLIENT_ID>",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  }
}
